      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n\n  body {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    background-color: #F4F5F7;\n    color: #1B2A3A;\n    margin: 0;\n    padding: 0;\n  }\n</style>\n<div class=\"min-h-screen flex items-center justify-center p-4\" data-kid=\"1\" data-name=\"centered page layout container\">\n<div class=\"w-full max-w-[440px] bg-[#FFFFFF] rounded-[10px] border border-[#D1D5D8] p-[32px] shadow-[0_2px_8px_rgba(27,42,58,0.04)]\" data-kid=\"1-1\" data-name=\"login card panel\">\n<!-- Header -->\n<div class=\"flex items-center gap-3 mb-8\" data-kid=\"1-1-1\" data-name=\"brand header row\">\n<div class=\"w-10 h-10 bg-[#1B2A3A] text-white flex items-center justify-center rounded-[8px]\" data-kid=\"1-1-1-1\" data-name=\"brand logo tile with icon\">\n<i class=\"bi bi-shield-check text-xl\" data-kid=\"1-1-1-1-1\" data-name=\"shield check security icon\"></i>\n</div>\n<div data-kid=\"1-1-1-2\" data-name=\"brand text block\">\n<div class=\"text-[16px] font-bold leading-tight text-[#1B2A3A]\" data-kid=\"1-1-1-2-1\" data-name='brand name heading \"Bank Mitra\"'>Bank Mitra</div>\n<div class=\"text-[12px] font-medium text-[#53595F]\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle tagline\">Sistem Tata Kelola IT</div>\n</div>\n</div>\n<!-- Title -->\n<div class=\"mb-8\" data-kid=\"1-1-2\" data-name=\"page title section\">\n<h1 class=\"text-[24px] font-bold text-[#1B2A3A] m-0 mb-1\" data-kid=\"1-1-2-1\" data-name='login page headline \"Masuk\"'>Masuk</h1>\n<p class=\"text-[14px] text-[#53595F] m-0\" data-kid=\"1-1-2-2\" data-name=\"login page description text\">Akses portal inventaris dan ruang server</p>\n</div>\n<!-- Primary Action: Passkey -->\n<button class=\"w-full h-[44px] bg-[#0E5C58] text-[#FFFFFF] rounded-[8px] flex items-center justify-center gap-2.5 text-[14px] font-semibold hover:bg-[#0B4B48] transition-colors focus:outline-none focus:ring-2 focus:ring-[#0E5C58] focus:ring-offset-2\" data-kid=\"1-1-3\" data-name=\"primary passkey login button\" type=\"button\">\n<i class=\"bi bi-fingerprint text-lg\" data-kid=\"1-1-3-1\" data-name=\"fingerprint icon\"></i>\n<span data-kid=\"1-1-3-2\" data-name=\"passkey login button label\">Masuk dengan passkey</span>\n</button>\n<!-- Divider -->\n<div class=\"flex items-center gap-4 my-6\" data-kid=\"1-1-4\" data-name=\"or-divider row\">\n<div class=\"flex-1 h-px bg-[#D1D5D8]\" data-kid=\"1-1-4-1\" data-name=\"left divider line\"></div>\n<div class=\"text-[12px] text-[#53595F] font-semibold tracking-wide uppercase\" data-kid=\"1-1-4-2\" data-name='divider \"or\" label'>Atau</div>\n<div class=\"flex-1 h-px bg-[#D1D5D8]\" data-kid=\"1-1-4-3\" data-name=\"right divider line\"></div>\n</div>\n<!-- Password Fallback Form -->\n<form class=\"m-0\" data-kid=\"1-1-5\" data-name=\"password fallback login form\">\n<div class=\"mb-4\" data-kid=\"1-1-5-1\" data-name=\"username field group\">\n<label class=\"block text-[14px] font-medium text-[#1B2A3A] mb-1.5\" data-kid=\"1-1-5-1-1\" data-name='username field label \"Nama pengguna\"'>Nama pengguna</label>\n<input autocomplete=\"username\" class=\"w-full h-[44px] px-3 bg-[#FFFFFF] border border-[#D1D5D8] rounded-[8px] text-[14px] text-[#1B2A3A] placeholder-[#53595F] focus:outline-none focus:border-[#0E5C58] focus:ring-1 focus:ring-[#0E5C58] transition-shadow\" data-kid=\"1-1-5-1-2\" data-name=\"username input field\" placeholder=\"ID Teknisi atau Email\" type=\"text\"/>\n</div>\n<div class=\"mb-6\" data-kid=\"1-1-5-2\" data-name=\"password field group\">\n<label class=\"block text-[14px] font-medium text-[#1B2A3A] mb-1.5\" data-kid=\"1-1-5-2-1\" data-name='password field label \"Kata sandi\"'>Kata sandi</label>\n<div class=\"relative\" data-kid=\"1-1-5-2-2\" data-name=\"password input wrapper\">\n<input autocomplete=\"current-password\" class=\"w-full h-[44px] pl-3 pr-11 bg-[#FFFFFF] border border-[#D1D5D8] rounded-[8px] text-[14px] text-[#1B2A3A] focus:outline-none focus:border-[#0E5C58] focus:ring-1 focus:ring-[#0E5C58] transition-shadow\" data-kid=\"1-1-5-2-2-1\" data-name=\"password input field\" type=\"password\" value=\"admin12345\"/>\n<button class=\"absolute right-1 top-1 h-[36px] w-[36px] flex items-center justify-center text-[#53595F] hover:text-[#1B2A3A] focus:outline-none rounded-[6px]\" data-kid=\"1-1-5-2-2-2\" data-name=\"show/hide password toggle button\" type=\"button\">\n<i class=\"bi bi-eye\" data-kid=\"1-1-5-2-2-2-1\" data-name=\"eye password visibility icon\"></i>\n</button>\n</div>\n</div>\n<!-- Reserved Inline Error Space (Hidden by default, shown here as example of structure but technically inactive) -->\n<!--\n      <div class=\"mb-4 p-3 bg-[#A5292B]/10 border border-[#A5292B]/20 rounded-[8px] text-[13px] text-[#A5292B] flex items-start gap-2\">\n        <i class=\"bi bi-exclamation-circle mt-0.5\"></i>\n        <span>Kredensial tidak valid. Sisa percobaan: 4.</span>\n      </div>\n      -->\n<button class=\"w-full h-[44px] bg-[#FFFFFF] text-[#1B2A3A] border border-[#D1D5D8] rounded-[8px] flex items-center justify-center text-[14px] font-semibold hover:bg-[#F4F5F7] transition-colors focus:outline-none focus:ring-2 focus:ring-[#D1D5D8] focus:ring-offset-2\" data-kid=\"1-1-5-3\" data-name=\"secondary password login button\" type=\"button\">\n        Masuk dengan kata sandi\n      </button>\n</form>\n<!-- Footer Action -->\n<div class=\"mt-8 text-center\" data-kid=\"1-1-6\" data-name=\"footer action section\">\n<a class=\"inline-flex items-center gap-1.5 text-[13px] font-medium text-[#53595F] hover:text-[#1B2A3A] transition-colors no-underline\" data-kid=\"1-1-6-1\" data-name=\"contact administrator link\" href=\"#\">\n<i class=\"bi bi-headset\" data-kid=\"1-1-6-1-1\" data-name=\"headset support icon\"></i>\n        Hubungi Administrator Sistem\n      </a>\n</div>\n</div>\n</div>",
