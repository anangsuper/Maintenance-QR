      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n\n  :root {\n    --canvas: oklch(0.97 0.003 250); /* #F4F5F7 */\n    --surface: oklch(1 0 0); /* #FFFFFF */\n    --navy: oklch(0.28 0.035 250); /* #1B2A3A */\n    --text-sec: oklch(0.46 0.012 250); /* #53595F */\n    --divider: oklch(0.87 0.006 250); /* #D1D5D8 */\n    --teal: oklch(0.43 0.07 190); /* #0E5C58 */\n    --selected: oklch(0.94 0.025 190); /* #D9F1EF */\n    \n    --warn: oklch(0.49 0.10 65); /* #875315 */\n    --warn-bg: oklch(0.96 0.04 70);\n    --error: oklch(0.48 0.16 25); /* #A5292B */\n    --error-bg: oklch(0.96 0.05 25); \n    --success: oklch(0.43 0.09 150); /* #255D34 */\n    --success-bg: oklch(0.96 0.05 150);\n  }\n  \n  body {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    background-color: var(--canvas);\n    color: var(--navy);\n    margin: 0;\n  }\n</style>\n<!-- Sidebar -->\n<aside class=\"fixed top-0 left-0 bottom-0 w-[240px] bg-[var(--surface)] border-r border-[var(--divider)] z-20 overflow-y-auto\" data-kid=\"1\" data-name=\"sidebar navigation panel\">\n<nav class=\"flex flex-col gap-1 px-4 py-6\" data-kid=\"1-1\" data-name=\"sidebar navigation menu\">\n<div class=\"mb-4\" data-kid=\"1-1-1\" data-name=\"brand header container\">\n<div class=\"flex items-center gap-2 px-3 text-[var(--navy)] font-bold text-lg\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name\">\n<i class=\"bi bi-bank\" data-kid=\"1-1-1-1-1\" data-name=\"bank logo icon\"></i> Bank Mitra\n      </div>\n</div>\n<a class=\"flex items-center gap-3 px-3 py-[10px] rounded-[8px] text-[14px] text-[var(--text-sec)] hover:bg-[var(--canvas)] transition-colors\" data-kid=\"1-1-2\" data-name=\"sidebar navigation link to IT Ops dashboard\" href=\"#\">\n<i class=\"bi bi-grid-1x2 text-[16px]\" data-kid=\"1-1-2-1\" data-name=\"grid icon\"></i> Dashboard IT Ops\n    </a>\n<a class=\"flex items-center gap-3 px-3 py-[10px] rounded-[8px] text-[14px] font-semibold text-[var(--navy)] bg-[var(--selected)]\" data-kid=\"1-1-3\" data-name=\"active sidebar navigation link to computer data\" href=\"#\">\n<i class=\"bi bi-pc-display text-[16px]\" data-kid=\"1-1-3-1\" data-name=\"computer display icon\"></i> Data Komputer &amp; PC\n    </a>\n<a class=\"flex items-center gap-3 px-3 py-[10px] rounded-[8px] text-[14px] text-[var(--text-sec)] hover:bg-[var(--canvas)] transition-colors\" data-kid=\"1-1-4\" data-name=\"sidebar navigation link to IT findings\" href=\"#\">\n<i class=\"bi bi-exclamation-triangle text-[16px]\" data-kid=\"1-1-4-1\" data-name=\"warning triangle icon\"></i> Temuan Kendala IT\n    </a>\n<a class=\"flex items-center gap-3 px-3 py-[10px] rounded-[8px] text-[14px] text-[var(--text-sec)] hover:bg-[var(--canvas)] transition-colors\" data-kid=\"1-1-5\" data-name=\"sidebar navigation link to server room log\" href=\"#\">\n<i class=\"bi bi-door-closed text-[16px]\" data-kid=\"1-1-5-1\" data-name=\"closed door icon\"></i> Log Ruang Server\n    </a>\n<div class=\"h-[1px] bg-[var(--divider)] my-2 mx-3\" data-kid=\"1-1-6\" data-name=\"sidebar section divider line\"></div>\n<a class=\"flex items-center gap-3 px-3 py-[10px] rounded-[8px] text-[14px] text-[var(--text-sec)] hover:bg-[var(--canvas)] transition-colors\" data-kid=\"1-1-7\" data-name=\"sidebar navigation link to mutations and disposal\" href=\"#\">\n<i class=\"bi bi-arrow-left-right text-[16px]\" data-kid=\"1-1-7-1\" data-name=\"arrow swap icon\"></i> Mutasi &amp; Afkir\n    </a>\n<a class=\"flex items-center gap-3 px-3 py-[10px] rounded-[8px] text-[14px] text-[var(--text-sec)] hover:bg-[var(--canvas)] transition-colors\" data-kid=\"1-1-8\" data-name=\"sidebar navigation link to procurement memos\" href=\"#\">\n<i class=\"bi bi-file-earmark-text text-[16px]\" data-kid=\"1-1-8-1\" data-name=\"document icon\"></i> Memo Pengadaan\n    </a>\n</nav>\n</aside>\n<!-- Topbar -->\n<header class=\"fixed top-0 left-[240px] right-0 h-[64px] bg-[var(--surface)] border-b border-[var(--divider)] flex items-center justify-between px-6 z-10\" data-kid=\"2\" data-name=\"top header bar\">\n<div class=\"flex items-center gap-4\" data-kid=\"2-1\" data-name=\"header search container\">\n<div class=\"relative w-[320px]\" data-kid=\"2-1-1\" data-name=\"global search input with icon\">\n<i class=\"bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-sec)]\" data-kid=\"2-1-1-1\" data-name=\"search magnifier icon\"></i>\n<input class=\"w-full h-[36px] pl-9 pr-3 rounded-[8px] border border-[var(--divider)] text-[14px] text-[var(--navy)] bg-[var(--canvas)] focus:bg-[var(--surface)] focus:outline-none focus:border-[var(--teal)] placeholder:text-[var(--text-sec)] transition-colors\" data-kid=\"2-1-1-2\" data-name=\"global search input field\" placeholder=\"Cari aset, serial, pengguna...\" type=\"text\"/>\n</div>\n</div>\n<div class=\"flex items-center gap-4 text-[var(--text-sec)]\" data-kid=\"2-2\" data-name=\"header right-side actions group\">\n<button class=\"relative w-9 h-9 flex items-center justify-center rounded-[8px] hover:bg-[var(--canvas)] transition-colors text-[18px]\" data-kid=\"2-2-1\" data-name=\"upload notification button with badge\">\n<i class=\"bi bi-cloud-arrow-up\" data-kid=\"2-2-1-1\" data-name=\"cloud upload icon\"></i>\n<span class=\"absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-[var(--warn)]\" data-kid=\"2-2-1-2\" data-name=\"notification dot indicator\"></span>\n</button>\n<button class=\"w-9 h-9 flex items-center justify-center rounded-[8px] hover:bg-[var(--canvas)] transition-colors text-[18px]\" data-kid=\"2-2-2\" data-name=\"help button\">\n<i class=\"bi bi-question-circle\" data-kid=\"2-2-2-1\" data-name=\"question mark help icon\"></i>\n</button>\n<div class=\"h-6 w-[1px] bg-[var(--divider)]\" data-kid=\"2-2-3\" data-name=\"vertical divider between actions\"></div>\n<button class=\"flex items-center gap-2 hover:bg-[var(--canvas)] p-1 pr-2 rounded-[8px] transition-colors cursor-pointer text-left\" data-kid=\"2-2-4\" data-name=\"user profile button\">\n<div class=\"w-8 h-8 rounded-full bg-[var(--selected)] border border-[var(--divider)] flex items-center justify-center text-[var(--teal)] text-[11px] font-bold\" data-kid=\"2-2-4-1\" data-name=\"user avatar initials circle\">\n        AK\n      </div>\n<span class=\"text-[14px] font-medium text-[var(--navy)]\" data-kid=\"2-2-4-2\" data-name=\"user display name\">Admin KPO</span>\n</button>\n</div>\n</header>\n<!-- Main Content -->\n<main class=\"ml-[240px] mt-[64px] p-6\" data-kid=\"3\" data-name=\"main content area\">\n<div class=\"max-w-[1152px]\" data-kid=\"3-1\" data-name=\"page content inner container\">\n<!-- Heading Row -->\n<div class=\"flex items-center justify-between mb-4 h-[48px]\" data-kid=\"3-1-1\" data-name=\"page heading and actions row\">\n<div class=\"flex items-baseline gap-3\" data-kid=\"3-1-1-1\" data-name=\"page title group\">\n<h1 class=\"text-[24px] font-bold text-[var(--navy)] m-0 leading-none\" data-kid=\"3-1-1-1-1\" data-name=\"page title heading\">Data Komputer &amp; PC</h1>\n<span class=\"text-[14px] text-[var(--text-sec)]\" data-kid=\"3-1-1-1-2\" data-name=\"total asset count metadata\">1,204 unit</span>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"3-1-1-2\" data-name=\"page action buttons group\">\n<button class=\"h-[36px] px-3 rounded-[8px] border border-[var(--divider)] bg-[var(--surface)] text-[var(--navy)] text-[14px] font-medium hover:bg-[var(--canvas)] transition-colors inline-flex items-center\" data-kid=\"3-1-1-2-1\" data-name=\"import assets button\">\n<i class=\"bi bi-upload mr-1.5 text-[15px]\" data-kid=\"3-1-1-2-1-1\" data-name=\"upload icon\"></i> Import\n        </button>\n<button class=\"h-[36px] px-3 rounded-[8px] border border-[var(--divider)] bg-[var(--surface)] text-[var(--navy)] text-[14px] font-medium hover:bg-[var(--canvas)] transition-co