      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css');\n\nbody {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    background-color: #F4F5F7;\n    color: #1B2A3A;\n    margin: 0;\n}\n.tabular-nums {\n    font-variant-numeric: tabular-nums;\n}\n::-webkit-scrollbar {\n    width: 6px;\n    height: 6px;\n}\n::-webkit-scrollbar-track {\n    background: transparent;\n}\n::-webkit-scrollbar-thumb {\n    background: #D1D5D8;\n    border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n    background: #A0A5AA;\n}\n</style>\n<div class=\"flex h-screen w-full overflow-hidden bg-[#F4F5F7]\" data-kid=\"1\" data-name=\"full-screen app layout container\">\n<!-- Navigation (240px) -->\n<aside class=\"w-[240px] bg-[#FFFFFF] border-r border-[#D1D5D8] flex flex-col shrink-0\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n<!-- Logo Area (64px) -->\n<div class=\"h-[64px] flex items-center px-5 border-b border-[#D1D5D8]\" data-kid=\"1-1-1\" data-name=\"sidebar logo bar with border\">\n<i class=\"bi bi-shield-check text-[#0E5C58] text-[22px] mr-2.5\" data-kid=\"1-1-1-1\" data-name=\"shield check logo icon\"></i>\n<span class=\"font-bold text-[15px] tracking-tight\" data-kid=\"1-1-1-2\" data-name='app title \"QR Maintenance\"'>QR Maintenance</span>\n</div>\n<!-- Nav Links -->\n<div class=\"flex-1 overflow-y-auto py-5 px-3 flex flex-col gap-1\" data-kid=\"1-1-2\" data-name=\"scrollable navigation link list\">\n<div class=\"text-[11px] font-bold text-[#53595F] uppercase tracking-wider mb-2 px-3\" data-kid=\"1-1-2-1\" data-name='nav section label \"Operasional\"'>Operasional</div>\n<a class=\"flex items-center h-[40px] px-3 rounded-[8px] bg-[#D9F1EF] text-[#1B2A3A] font-semibold text-[14px]\" data-kid=\"1-1-2-2\" data-name=\"active Dashboard IT Ops nav link\" href=\"#\">\n<i class=\"bi bi-grid-1x2 text-[#0E5C58] w-7\" data-kid=\"1-1-2-2-1\" data-name=\"dashboard grid icon\"></i>\n                Dashboard IT Ops\n            </a>\n<a class=\"flex items-center h-[40px] px-3 rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7] hover:text-[#1B2A3A] font-medium text-[14px] transition-colors\" data-kid=\"1-1-2-3\" data-name=\"Data Komputer &amp; PC nav link\" href=\"#\">\n<i class=\"bi bi-pc-display w-7\" data-kid=\"1-1-2-3-1\" data-name=\"computer display icon\"></i>\n                Data Komputer &amp; PC\n            </a>\n<a class=\"flex items-center h-[40px] px-3 rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7] hover:text-[#1B2A3A] font-medium text-[14px] transition-colors\" data-kid=\"1-1-2-4\" data-name=\"Temuan Kendala IT nav link\" href=\"#\">\n<i class=\"bi bi-exclamation-triangle w-7\" data-kid=\"1-1-2-4-1\" data-name=\"warning triangle icon\"></i>\n                Temuan Kendala IT\n            </a>\n<a class=\"flex items-center h-[40px] px-3 rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7] hover:text-[#1B2A3A] font-medium text-[14px] transition-colors\" data-kid=\"1-1-2-5\" data-name=\"Log Ruang Server nav link\" href=\"#\">\n<i class=\"bi bi-door-closed w-7\" data-kid=\"1-1-2-5-1\" data-name=\"closed server door icon\"></i>\n                Log Ruang Server\n            </a>\n<div class=\"text-[11px] font-bold text-[#53595F] uppercase tracking-wider mt-6 mb-2 px-3\" data-kid=\"1-1-2-6\" data-name='nav section label \"Aset &amp; Sarpras\"'>Aset &amp; Sarpras</div>\n<a class=\"flex items-center h-[40px] px-3 rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7] hover:text-[#1B2A3A] font-medium text-[14px] transition-colors\" data-kid=\"1-1-2-7\" data-name=\"Pengadaan &amp; Memo nav link\" href=\"#\">\n<i class=\"bi bi-file-earmark-text w-7\" data-kid=\"1-1-2-7-1\" data-name=\"text document icon\"></i>\n                Pengadaan &amp; Memo\n            </a>\n<a class=\"flex items-center h-[40px] px-3 rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7] hover:text-[#1B2A3A] font-medium text-[14px] transition-colors\" data-kid=\"1-1-2-8\" data-name=\"Mutasi Aset nav link\" href=\"#\">\n<i class=\"bi bi-arrow-left-right w-7\" data-kid=\"1-1-2-8-1\" data-name=\"left-right swap arrow icon\"></i>\n                Mutasi Aset\n            </a>\n<a class=\"flex items-center h-[40px] px-3 rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7] hover:text-[#1B2A3A] font-medium text-[14px] transition-colors\" data-kid=\"1-1-2-9\" data-name=\"Penghapusan Aset nav link\" href=\"#\">\n<i class=\"bi bi-trash w-7\" data-kid=\"1-1-2-9-1\" data-name=\"trash can icon\"></i>\n                Penghapusan Aset\n            </a>\n</div>\n</aside>\n<!-- Main Viewport (1200px equivalent) -->\n<main class=\"flex-1 flex flex-col min-w-0 bg-[#F4F5F7]\" data-kid=\"1-2\" data-name=\"main content viewport\">\n<!-- Topbar (64px) -->\n<header class=\"h-[64px] bg-[#FFFFFF] border-b border-[#D1D5D8] flex items-center justify-between px-6 shrink-0 sticky top-0 z-10\" data-kid=\"1-2-1\" data-name=\"top header bar with search\">\n<div class=\"font-semibold text-[15px] text-[#1B2A3A]\" data-kid=\"1-2-1-1\" data-name='page title \"Dashboard IT Ops\"'>Dashboard IT Ops</div>\n<div class=\"flex items-center gap-4\" data-kid=\"1-2-1-2\" data-name=\"top bar action controls container\">\n<button class=\"flex items-center gap-2 h-[36px] px-3 bg-[#F4F5F7] border border-[#D1D5D8] rounded-[8px] text-[#53595F] text-[13px] hover:bg-[#e9eaec] transition-colors\" data-kid=\"1-2-1-2-1\" data-name=\"global search input button (Ctrl+K)\">\n<i class=\"bi bi-search\" data-kid=\"1-2-1-2-1-1\" data-name=\"magnifying glass search icon\"></i>\n<span data-kid=\"1-2-1-2-1-2\" data-name='search placeholder text \"Cari aset...\"'>Cari aset...</span>\n<kbd class=\"ml-2 font-mono text-[10px] font-semibold bg-[#FFFFFF] border border-[#D1D5D8] rounded-[4px] px-1.5 py-0.5 text-[#53595F]\" data-kid=\"1-2-1-2-1-3\" data-name=\"Ctrl+K keyboard shortcut hint badge\">Ctrl+K</kbd>\n</button>\n<div class=\"w-px h-6 bg-[#D1D5D8]\" data-kid=\"1-2-1-2-2\" data-name=\"vertical divider between actions\"></div>\n<button class=\"flex items-center gap-1.5 text-[13px] font-semibold text-[#875315] hover:opacity-80 transition-opacity\" data-kid=\"1-2-1-2-3\" data-name='offline/pending status badge \"2 tertunda\"'>\n<i class=\"bi bi-cloud-slash\" data-kid=\"1-2-1-2-3-1\" data-name=\"cloud slash icon\"></i>\n                    2 tertunda\n                </button>\n<button class=\"text-[#53595F] hover:text-[#1B2A3A] ml-2 text-[18px] transition-colors\" data-kid=\"1-2-1-2-4\" data-name=\"help/question mark button\">\n<i class=\"bi bi-question-circle\" data-kid=\"1-2-1-2-4-1\" data-name=\"question circle help icon\"></i>\n</button>\n<div class=\"w-[36px] h-[36px] rounded-[8px] bg-[#0E5C58] text-white flex items-center justify-center font-bold text-[13px] ml-2 cursor-pointer shadow-[0_1px_2px_rgba(0,0,0,0.1)]\" data-kid=\"1-2-1-2-5\" data-name=\"AI avatar user chip\">\n                    AI\n                </div>\n</div>\n</header>\n<!-- Content Area -->\n<div class=\"flex-1 overflow-y-auto p-6\" data-kid=\"1-2-2\" data-name=\"scrollable content area with padding\">\n<div class=\"max-w-[1152px] mx-auto flex flex-col\" data-kid=\"1-2-2-1\" data-name=\"centered max-width dashboard content flow\">\n<!-- Heading Row (48px) -->\n<div class=\"flex justify-between items-center h-[48px] shrink-0\" data-kid=\"1-2-2-1-1\" data-name=\"heading row with page title and filters\">\n<h1 class=\"text-[24px] font-bold text-[#1B2A3A] tracking-tight\" data-kid=\"1-2-2-1-1-1\" data-name='page headline \"Antrean Pemeliharaan\"'>Antrean Pemeliharaan</h1>\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-1-2\" data-name=\"filter dropdowns container\">\n<div class=\"relative\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"branch selector dropdown wrapper\">\n<select class=\"h-[36px] bg-[#FFFFFF] border border-[#D1D5D8] rounded-[8px] pl-3 pr-8 text-[14px] font-semibold text-[#1B2A3A] outline-none hover:border-[#A0A5AA] cursor-pointer appearance-none transition-colors\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"branch filter dropdown select\">\n<option data-kid=\"1-2-2-1-1-2-1-1-1\" data-name='option \"Semua Cabang\"'>Semua Cabang</option>\n<option data-kid=\"1-2-2-1-1-2-1-1-2\" data-name='option \"KPO Bank Mitra\" (selected)' selected=\"\">KPO Bank Mitra</option>\n<option data-kid=\"1-2-2-1-1-2-1-1-3\" data-name='option \"KC Bandung\"'>KC Bandung</option>\n</select>\n<i class=\"bi bi-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[#53595F] text-[12px] pointer-events-none\" data-kid=\"1-2-2-1-1-2-1-2\" data-name=\"dropdown chevron-down icon\"></i>\n</div>\n<div class=\"relative\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"period selector dropdown wrapper\">\n<select class=\"h-[36px] bg-[#FFFFFF] border border-[#D1D5D8] rounded-[8px] pl-3 pr-8 text-[14px] font-semibold text-[#1B2A3A] outline-none hover:border-[#A0A5AA] cursor-pointer appearance-none transition-colors\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"period filter dropdown select\">\n<option data-kid=\"1-2-2-1-1-2-2-1-1\" data-name='option \"Oktober 2026\" (selected)' selected=\"\">Oktober 2026</option>\n<option data-kid=\"1-2-2-1-1-2-2-1-2\" data-name='option \"September 2026\"'>September 2026</option>\n</select>\n<i class=\"bi bi-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[#53595F] text-[12px] pointer-events-none\" data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"dropdown chevron-down icon\"></i>\n</div>\n</div>\n</div>\n<div class=\"h-4 shrink-0\" data-kid=\"1-2-2-1-2\" data-name=\"spacing spacer div\"></div>\n<!-- Metric Strip (88px) -->\n<div class=\"bg-[#FFFFFF] border border-[#D1D5D8] rounded-[10px] h-[88px] flex overflow-hidden shrink-0\" data-kid=\"1-2-2-1-3\" data-name=\"metric strip card\">\n<div class=\"flex-1 flex flex-col justify-center px-6 cursor-pointer bg-[#D9F1EF] transition-colors relative\" data-kid=\"1-2-2-1-3-1\" data-name='active metric cell \"Belum dipelihara\"'>\n<div class=\"absolute left-0 top-0 bottom-0 w-1 bg-[#0E5C58]\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"teal left accent bar on metric cell\"></div>\n<div class=\"text-[32px] font-bold text-[#1B2A3A] tabular-nums leading-none mb-1 tracking-tight\" data-kid=\"1-2-2-1-3-1-2\" data-name='metric value \"42\"'>42</div>\n<div class=\"text-[13px] font-medium text-[#1B2A3A]\" data-kid=\"1-2-2-1-3-1-3\" data-name='metric label \"Belum dipelihara\"'>Belum dipelihara</div>\n</div>\n<div class=\"w-px bg-[#D1D5D8] h-[56px] my-auto\" data-kid=\"1-2-2-1-3-2\" data-name=\"vertical divider between metrics\"></div>\n<div class=\"flex-1 flex flex-col justify-center px-6 cursor-pointer hover:bg-[#F4F5F7] transition-colors\" data-kid=\"1-2-2-1-3-3\" data-name='metric cell \"Temuan terbuka\"'>\n<div class=\"flex items-center gap-2.5 mb-1\" data-kid=\"1-2-2-1-3-3-1\" data-name=\"value + badge row for metric\">\n<div class=\"text-[32px] font-bold text-[#A5292B] tabular-nums leading-none tracking-tight\" data-kid=\"1-2-2-1-3-3-1-1\" data-name='metric value \"8\"'>8</div>\n<span class=\"bg-[#F4F5F7] text-[#53595F] text-[11px] font-bold px-2 py-0.5 rounded-[4px] border border-[#D1D5D8] tracking-wide uppercase\" data-kid=\"1-2-2-1-3-3-1-2\" data-name='scope badge \"Semua periode\"'>Semua periode</span>\n</div>\n<div class=\"text-[13px] font-medium text-[#53595F]\" data-kid=\"1-2-2-1-3-3-2\" data-name='metric label \"Temuan terbuka\"'>Temuan terbuka</div>\n</div>\n</div>\n<div class=\"h-4 shrink-0\" data-kid=\"1-2-2-1-4\" data-name=\"spacing spacer div\"></div>\n<!-- Tabs (44px) -->\n<div class=\"flex gap-6 h-[44px] border-b border-[#D1D5D8] shrink-0\" data-kid=\"1-2-2-1-5\" data-name=\"tab bar with two view tabs\">\n<button class=\"h-full flex items-center font-bold text-[14px] text-[#1B2A3A] border-b-[3px] border-[#0E5C58] px-1 relative top-[1px]\" data-kid=\"1-2-2-1-5-1\" data-name='active tab \"Belum dipelihara (42)\"'>\n                        Belum dipelihara (42)\n                    </button>\n<button class=\"h-full flex items-center font-semibold text-[14px] text-[#53595F] hover:text-[#1B2A3A] border-b-[3px] border-transparent px-1 transition-colors\" data-kid=\"1-2-2-1-5-2\" data-name='inactive tab \"Temuan terbuka (8)\"'>\n                        Temuan terbuka (8)\n                    </button>\n</div>\n<div class=\"h-4 shrink-0\" data-kid=\"1-2-2-1-6\" data-name=\"spacing spacer div\"></div>\n<!-- Queue Surface -->\n<div class=\"bg-[#FFFFFF] border border-[#D1D5D8] rounded-[10px] flex flex-col shrink-0 overflow-hidden\" data-kid=\"1-2-2-1-7\" data-name=\"queue table card surface\">\n<!-- Toolbar (56px) -->\n<div class=\"h-[56px] px-4 flex justify-between items-center border-b border-[#D1D5D8] bg-[#FFFFFF]\" data-kid=\"1-2-2-1-7-1\" data-name=\"toolbar row with filter and scan\">\n<div class=\"relative\" data-kid=\"1-2-2-1-7-1-1\" data-name=\"queue filter input wrapper with icon\">\n<i class=\"bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-[#53595F] text-[14px]\" data-kid=\"1-2-2-1-7-1-1-1\" data-name=\"magnifying glass icon in input\"></i>\n<input class=\"h-[36px] w-[280px] pl-9 pr-3 text-[14px] font-medium text-[#1B2A3A] border border-[#D1D5D8] rounded-[8px] outline-none focus:border-[#0E5C58] placeholder:text-[#A0A5AA] transition-colors\" data-kid=\"1-2-2-1-7-1-1-2\" data-name=\"queue filter search input field\" placeholder=\"Saring antrean...\" type=\"text\"/>\n</div>\n<button class=\"h-[36px] px-4 bg-[#0E5C58] hover:bg-[#0c4f4b] text-white rounded-[8px] font-semibold text-[14px] flex items-center gap-2 transition-colors\" data-kid=\"1-2-2-1-7-1-2\" data-name='primary \"Scan QR Unit\" action button'>\n<i class=\"bi bi-qr-code-scan\" data-kid=\"1-2-2-1-7-1-2-1\" data-name=\"QR code scan icon\"></i>\n                            Scan QR Unit\n                        </button>\n</div>\n<!-- Table Header (40px) -->\n<div class=\"h-[40px] px-4 flex items-center bg-[#F4F5F7] border-b border-[#D1D5D8] text-[12px] font-bold text-[#53595F] uppercase tracking-wider\" data-kid=\"1-2-2-1-7-2\" data-name=\"table header row\">\n<div class=\"w-32 shrink-0\" data-kid=\"1-2-2-1-7-2-1\" data-name='column header \"Kode Inventaris\"'>Kode Inventaris</div>\n<div class=\"flex-1 min-w-0 pl-4\" data-kid=\"1-2-2-1-7-2-2\" data-name='column header \"Perangkat &amp; Pengguna\"'>Perangkat &amp; Pengguna</div>\n<div class=\"w-56 shrink-0 pl-4\" data-kid=\"1-2-2-1-7-2-3\" data-name='column header \"Cabang &amp; Ruangan\"'>Cabang &amp; Ruangan</div>\n<div class=\"w-48 shrink-0 pl-4\" data-kid=\"1-2-2-1-7-2-4\" data-name='column header \"Pemeliharaan Terakhir\"'>Pemeliharaan Terakhir</div>\n<div class=\"w-28 shrink-0 text-right\" data-kid=\"1-2-2-1-7-2-5\" data-name='column header \"Aksi\"'>Aksi</div>\n</div>\n<!-- Rows (8x 48px) -->\n<div class=\"flex flex-col\" data-kid=\"1-2-2-1-7-3\" data-name=\"queue table body rows container\">\n<!-- Row 1 -->\n<div class=\"h-[48px] px-4 flex items-center border-b border-[#D1D5D8] hover:bg-[#F4F5F7] transition-colors\" data-kid=\"1-2-2-1-7-3-1\" data-name=\"queue table row 1 (INV-IT-142)\">\n<div class=\"w-32 shrink-0 tabular-nums font-bold text-[13px] text-[#1B2A3A]\" data-kid=\"1-2-2-1-7-3-1-1\" data-name='asset inventory code \"INV-IT-142\"'>INV-IT-142</div>\n<div class=\"flex-1 min-w-0 flex items-baseline gap-2 truncate pr-4 pl-4\" data-kid=\"1-2-2-1-7-3-1-2\" data-name=\"device and user cell\">\n<span class=\"text-[14px] font-semibold text-[#1B2A3A] truncate\" data-kid=\"1-2-2-1-7-3-1-2-1\" data-name='device name \"PC Desktop Lenovo M70s\"'>PC Desktop Lenovo M70s</span>\n<span class=\"text-[13px] text-[#53595F] truncate\" data-kid=\"1-2-2-1-7-3-1-2-2\" data-name='user name \"Rina M.\"'>Rina M.</span>\n</div>\n<div class=\"w-56 shrink-0 flex items-baseline gap-1.5 truncate pr-4 pl-4\" data-kid=\"1-2-2-1-7-3-1-3\" data-name=\"branch and room cell\">\n<span class=\"text-[13px] font-semibold text-[#1B2A3A]\" data-kid=\"1-2-2-1-7-3-1-3-1\" data-name='branch \"KPO\"'>KPO</span>\n<span class=\"text