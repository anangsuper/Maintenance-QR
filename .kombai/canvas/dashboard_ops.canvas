      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css');\n\n  body {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n  }\n</style>\n<div class=\"flex h-screen bg-[#F4F5F7] text-[#1B2A3A]\" data-kid=\"1\" data-name=\"page layout container with sidebar and main area\">\n<!-- Sidebar -->\n<aside class=\"w-[240px] bg-[#FFFFFF] border-r border-[#D1D5D8] flex flex-col flex-shrink-0\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n<!-- Logo -->\n<div class=\"h-[64px] flex items-center px-6 border-b border-[#D1D5D8]\" data-kid=\"1-1-1\" data-name=\"sidebar header with logo\">\n<div class=\"font-bold text-[18px] text-[#1B2A3A]\" data-kid=\"1-1-1-1\" data-name=\"application logo text\">Bank Mitra</div>\n</div>\n<!-- Nav Links -->\n<nav class=\"flex-1 py-4 px-3 space-y-1 overflow-y-auto\" data-kid=\"1-1-2\" data-name=\"sidebar navigation menu\">\n<a class=\"flex items-center px-3 h-[40px] rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7]\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation link\" href=\"#\">\n<i class=\"bi bi-grid w-5 text-center mr-3\" data-kid=\"1-1-2-1-1\" data-name=\"grid dashboard icon\"></i>\n<span class=\"text-[14px] font-medium\" data-kid=\"1-1-2-1-2\" data-name=\"dashboard navigation label\">Dashboard</span>\n</a>\n<a class=\"flex items-center px-3 h-[40px] rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7]\" data-kid=\"1-1-2-2\" data-name=\"computer data navigation link\" href=\"#\">\n<i class=\"bi bi-pc-display w-5 text-center mr-3\" data-kid=\"1-1-2-2-1\" data-name=\"computer display icon\"></i>\n<span class=\"text-[14px] font-medium\" data-kid=\"1-1-2-2-2\" data-name=\"computer data navigation label\">Data Komputer &amp; PC</span>\n</a>\n<a class=\"flex items-center px-3 h-[40px] rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7]\" data-kid=\"1-1-2-3\" data-name=\"IT findings navigation link\" href=\"#\">\n<i class=\"bi bi-exclamation-triangle w-5 text-center mr-3\" data-kid=\"1-1-2-3-1\" data-name=\"warning triangle icon\"></i>\n<span class=\"text-[14px] font-medium\" data-kid=\"1-1-2-3-2\" data-name=\"IT findings navigation label\">Temuan Kendala IT</span>\n</a>\n<a class=\"flex items-center px-3 h-[40px] rounded-[8px] bg-[#D9F1EF] text-[#1B2A3A]\" data-kid=\"1-1-2-4\" data-name=\"server room log navigation link (active)\" href=\"#\">\n<i class=\"bi bi-door-closed w-5 text-center mr-3 text-[#0E5C58]\" data-kid=\"1-1-2-4-1\" data-name=\"door icon\"></i>\n<span class=\"text-[14px] font-semibold\" data-kid=\"1-1-2-4-2\" data-name=\"server room log navigation label\">Log Ruang Server</span>\n</a>\n<div class=\"pt-4 pb-2 px-3\" data-kid=\"1-1-2-5\" data-name=\"sidebar section divider wrapper\">\n<div class=\"text-[12px] font-bold text-[#53595F] uppercase tracking-wider\" data-kid=\"1-1-2-5-1\" data-name='section header label \"Modul Lainnya\"'>Modul Lainnya</div>\n</div>\n<a class=\"flex items-center px-3 h-[40px] rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7]\" data-kid=\"1-1-2-6\" data-name=\"procurement memo navigation link\" href=\"#\">\n<i class=\"bi bi-file-earmark-text w-5 text-center mr-3\" data-kid=\"1-1-2-6-1\" data-name=\"document file icon\"></i>\n<span class=\"text-[14px] font-medium\" data-kid=\"1-1-2-6-2\" data-name=\"procurement memo navigation label\">Memo Pengadaan</span>\n</a>\n<a class=\"flex items-center px-3 h-[40px] rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7]\" data-kid=\"1-1-2-7\" data-name=\"asset disposal navigation link\" href=\"#\">\n<i class=\"bi bi-trash3 w-5 text-center mr-3\" data-kid=\"1-1-2-7-1\" data-name=\"trash can icon\"></i>\n<span class=\"text-[14px] font-medium\" data-kid=\"1-1-2-7-2\" data-name=\"asset disposal navigation label\">Penghapusan Aset</span>\n</a>\n</nav>\n</aside>\n<!-- Main Content -->\n<div class=\"flex-1 flex flex-col min-w-0\" data-kid=\"1-2\" data-name=\"main content area\">\n<!-- Topbar -->\n<header class=\"h-[64px] bg-[#FFFFFF] border-b border-[#D1D5D8] flex items-center justify-between px-6 flex-shrink-0\" data-kid=\"1-2-1\" data-name=\"top header bar\">\n<div class=\"text-[14px] font-medium text-[#53595F] flex items-center gap-2\" data-kid=\"1-2-1-1\" data-name=\"current page context indicator\">\n<i class=\"bi bi-door-closed\" data-kid=\"1-2-1-1-1\" data-name=\"door icon in breadcrumb\"></i>\n<span data-kid=\"1-2-1-1-2\" data-name=\"current page name text\">Log Ruang Server</span>\n</div>\n<div class=\"flex items-center gap-4\" data-kid=\"1-2-1-2\" data-name=\"user actions container\">\n<button class=\"w-8 h-8 rounded-[8px] text-[#53595F] hover:bg-[#F4F5F7] flex items-center justify-center\" data-kid=\"1-2-1-2-1\" data-name=\"search button\">\n<i class=\"bi bi-search\" data-kid=\"1-2-1-2-1-1\" data-name=\"magnifying glass icon\"></i>\n</button>\n<div class=\"h-6 w-px bg-[#D1D5D8]\" data-kid=\"1-2-1-2-2\" data-name=\"vertical divider line\"></div>\n<div class=\"flex items-center gap-2 cursor-pointer\" data-kid=\"1-2-1-2-3\" data-name=\"user profile menu item\">\n<div class=\"w-8 h-8 rounded-full bg-[#D9F1EF] text-[#0E5C58] flex items-center justify-center font-bold text-[13px]\" data-kid=\"1-2-1-2-3-1\" data-name=\"user avatar with initials\">A</div>\n<span class=\"text-[14px] font-medium text-[#1B2A3A]\" data-kid=\"1-2-1-2-3-2\" data-name=\"user role label\">Administrator</span>\n</div>\n</div>\n</header>\n<!-- Page Content -->\n<main class=\"flex-1 overflow-auto p-6\" data-kid=\"1-2-2\" data-name=\"main scrollable content area\">\n<div class=\"max-w-[1152px] mx-auto\" data-kid=\"1-2-2-1\" data-name=\"content wrapper with max width\">\n<!-- Heading / Action Row -->\n<div class=\"flex items-center justify-between h-[48px]\" data-kid=\"1-2-2-1-1\" data-name=\"heading and actions row\">\n<h1 class=\"text-[20px] font-semibold text-[#1B2A3A]\" data-kid=\"1-2-2-1-1-1\" data-name=\"page title heading\">Log Ruang Server</h1>\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-1-2\" data-name=\"action buttons container\">\n<button class=\"h-[36px] px-4 rounded-[8px] border border-[#D1D5D8] bg-[#FFFFFF] text-[#1B2A3A] text-[14px] font-medium hover:bg-[#F4F5F7] flex items-center gap-2\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"print QR code button\">\n<i class=\"bi bi-qr-code-scan text-[#53595F]\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"QR code scan icon\"></i>\n              Cetak QR pintu\n            </button>\n<button class=\"h-[36px] px-4 rounded-[8px] border border-[#D1D5D8] bg-[#FFFFFF] text-[#1B2A3A] text-[14px] font-medium hover:bg-[#F4F5F7] flex items-center gap-2\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"export CSV button\">\n<i class=\"bi bi-download text-[#53595F]\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"download icon\"></i>\n              Ekspor CSV\n            </button>\n</div>\n</div>\n<div class=\"h-4\" data-kid=\"1-2-2-1-2\" data-name=\"vertical spacing spacer\"></div>\n<!-- Tabs -->\n<div class=\"flex items-center gap-6 h-[40px] border-b border-[#D1D5D8]\" data-kid=\"1-2-2-1-3\" data-name=\"tabs navigation bar\">\n<button class=\"h-full flex items-center gap-2 border-b-2 border-[#0E5C58] px-1 text-[14px] font-semibold text-[#1B2A3A]\" data-kid=\"1-2-2-1-3-1\" data-name='active \"inside room\" tab with count badge'>\n            Di dalam ruangan\n            <span class=\"bg-[#D9F1EF] text-[#0E5C58] text-[12px] px-2 py-0.5 rounded-full\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"visitor count badge\">3</span>\n</button>\n<button class=\"h-full flex items-center px-1 text-[14px] font-medium text-[#53595F] border-b-2 border-transparent hover:text-[#1B2A3A]\" data-kid=\"1-2-2-1-3-2\" data-name=\"history visits tab\">\n            Riwayat kunjungan\n          </button>\n</div>\n<div class=\"h-3\" data-kid=\"1-2-2-1-4\" data-name=\"vertical spacing spacer\"></div>\n<!-- Filters -->\n<div class=\"h-[76px] bg-[#FFFFFF] border border-[#D1D5D8] rounded-[10px] p-4 flex items-end gap-4\" data-kid=\"1-2-2-1-5\" data-name=\"filters bar container\">\n<div class=\"flex-1 max-w-[240px]\" data-kid=\"1-2-2-1-5-1\" data-name=\"branch filter field group\">\n<label class=\"block text-[12px] font-medium text-[#53595F] mb-1.5\" data-kid=\"1-2-2-1-5-1-1\" data-name=\"cabang filter label\">Cabang / Ruangan</label>\n<div class=\"relative\" data-kid=\"1-2-2-1-5-1-2\" data-name=\"select dropdown wrapper\">\n<select class=\"w-full h-[36px] bg-[#FFFFFF] border border-[#D1D5D8] rounded-[8px] px-3 pr-8 text-[14px] text-[#1B2A3A] appearance-none outline-none focus:border-[#0E5C58]\" data-kid=\"1-2-2-1-5-1-2-1\" data-name=\"room selection dropdown\">\n<option data-kid=\"1-2-2-1-5-1-2-1-1\" data-name=\"default all-rooms option\">Semua ruangan</option>\n<option data-kid=\"1-2-2-1-5-1-2-1-2\" data-name=\"Server KPO option\">Server KPO</option>\n<option data-kid=\"1-2-2-1-5-1-2-1-3\" data-name=\"Server KC Bandung option\">Server KC Bandung</option>\n</select>\n<i class=\"bi bi-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[#53595F] text-[12px] pointer-events-none\" data-kid=\"1-2-2-1-5-1-2-2\" data-name=\"dropdown chevron icon\"></i>\n</div>\n</div>\n<div class=\"flex-1 max-w-[280px]\" data-kid=\"1-2-2-1-5-2\" data-name=\"visitor search field group\">\n<label class=\"block text-[12px] font-medium text-[#53595F] mb-1.5\" data-kid=\"1-2-2-1-5-2-1\" data-name=\"search input label\">Cari pengunjung / instansi</label>\n<div class=\"relative\" data-kid=\"1-2-2-1-5-2-2\" data-name=\"search input wrapper with icon\">\n<i class=\"bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-[#53595F] text-[13px]\" data-kid=\"1-2-2-1-5-2-2-1\" data-name=\"search magnifying glass icon\"></i>\n<input class=\"w-full h-[36px] bg-[#FFFFFF] border border-[#D1D5D8] rounded-[8px] pl-9 pr-3 text-[14px] text-[#1B2A3A] outline-none focus:border-[#0E5C58]\" data-kid=\"1-2-2-1-5-2-2-2\" data-name=\"visitor name search input\" placeholder=\"Masukkan nama...\" type=\"text\"/>\n</div>\n</div>\n<button class=\"h-[36px] px-4 rounded-[8px] text-[#53595F] text-[14px] font-medium hover:bg-[#F4F5F7]\" data-kid=\"1-2-2-1-5-3\" data-name=\"reset filter button\">\n            Reset filter\n          </button>\n</div>\n<div class=\"h-3\" data-kid=\"1-2-2-1-6\" data-name=\"vertical spacing spacer\"></div>\n<!-- Table -->\n<div class=\"bg-[#FFFFFF] border border-[#D1D5D8] rounded-[10px] overflow-hidden\" data-kid=\"1-2-2-1-7\" data-name=\"data table card\">\n<!-- Table Header (40px) -->\n<div class=\"h-[40px] flex items-center px-4 border-b border-[#D1D5D8] bg-[#F4F5F7] text-[13px] font-medium text-[#53595F]\" data-kid=\"1-2-2-1-7-1\" data-name=\"table header row\">\n<div class=\"w-[200px]\" data-kid=\"1-2-2-1-7-1-1\" data-name=\"Pengunjung column header\">Pengunjung</div>\n<div class=\"w-[180px]\" data-kid=\"1-2-2-1-7-1-2\" data-name=\"Instansi column header\">Instansi / Divisi</div>\n<div class=\"w-[160px]\" data-kid=\"1-2-2-1-7-1-3\" data-name=\"Pendamping IT column header\">Pendamping IT</div>\n<div class=\"w-[160px]\" data-kid=\"1-2-2-1-7-1-4\" data-name=\"Ruangan column header\">Ruangan</div>\n<div class=\"w-[160px]\" data-kid=\"1-2-2-1-7-1-5\" data-name=\"Masuk column header\">Masuk</div>\n<div class=\"w-[120px]\" data-kid=\"1-2-2-1-7-1-6\" data-name=\"Suhu Awal column header\">Suhu Awal</div>\n<div class=\"w-[100px]\" data-kid=\"1-2-2-1-7-1-7\" data-name=\"Durasi column header\">Durasi</div>\n<div class=\"flex-1 text-right\" data-kid=\"1-2-2-1-7-1-8\" data-name=\"Aksi column header\">Aksi</div>\n</div>\n<!-- Table Rows (52px) -->\n<div class=\"divide-y divide-[#D1D5D8]\" data-kid=\"1-2-2-1-7-2\" data-name=\"table body rows container\">\n<!-- Row 1 -->\n<div class=\"h-[52px] flex items-center px-4 hover:bg-[#F4F5F7] group\" data-kid=\"1-2-2-1-7-2-1\" data-name=\"first data row\">\n<div class=\"w-[200px] text-[14px] font-medium text-[#1B2A3A] truncate pr-4\" data-kid=\"1-2-2-1-7-2-1-1\" data-name=\"visitor name cell\">Budi Santoso</div>\n<div class=\"w-[180px] text-[14px] text-[#53595F] truncate pr-4\" data-kid=\"1-2-2-1-7-2-1-2\" data-name=\"visitor institution cell\">Vendor Lintasarta</div>\n<div class=\"w-[160px] text-[14px] text-[#53595F] truncate pr-4\" data-kid=\"1-2-2-1-7-2-1-3\" data-name=\"IT companion cell\">Andi Prasetyo</div>\n<div class=\"w-[160px] text-[14px] text-[#1B2A3A] truncate pr-4\" data-kid=\"1-2-2-1-7-2-1-4\" data-name=\"server room cell\">Server KPO</div>\n<div class=\"w-[160px] text-[14px] text-[#1B2A3A] tabular-nums truncate pr-4\" data-kid=\"1-2-2-1-7-2-1-5\" data-name=\"entry time cell\">28 Okt, 08:15</div>\n<div class=\"w-[120px] text-[14px] text-[#1B2A3A] tabular-nums truncate pr-4\" data-kid=\"1-2-2-1-7-2-1-6\" data-name=\"initial temperature cell\">20.5 °C</div>\n<div class=\"w-[100px]\" data-kid=\"1-2-2-1-7-2-1-7\" data-name=\"duration cell wrapper\">\n<span class=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[6px] bg-[#FFF8EB] text-[#875315] text-[13px] font-medium tabular-nums border border-[#FDE68A]\" data-kid=\"1-2-2-1-7-2-1-7-1\" data-name=\"active duration badge with warning style\">\n<i class=\"bi bi-clock-history text-[11px]\" data-kid=\"1-2-2-1-7-2-1-7-1-1\" data-name=\"clock history icon\"></i> 124 min\n                </span>\n</div>\n<div class=\"flex-1 flex justify-end\" data-kid=\"1-2-2-1-7-2-1-8\" data-name=\"row actions cell\">\n<button class=\"h-[32px] px-3 rounded-[6px] border border-[#D1D5D8] bg-[#FFFFFF] text-[#1B2A3A] text-[13px] font-medium hover:bg-[#F4F5F7] shadow-sm\" data-kid=\"1-2-2-1-7-2-1-8-1\" data-name=\"view ticket button\">\n                  Lihat tiket\n                </button>\n</div>\n</div>\n<!-- Row 2 -->\n<div class=\"h-[52px] flex items-center px-4 hover:bg-[#F4F5F7] group\" data-kid=\"1-2-2-1-7-2-2\" data-name=\"second data row\">\n<div class=\"w-[200px] text-[14px] font-medium text-[#1B2A3A] truncate pr-4\" data-kid=\"1-2-2-1-7-2-2-1\" data-name=\"visitor name cell\">Diana Sari</div>\n<div class=\"w-[180px] text-[14px] text-[#53595F] truncate pr-4\" data-kid=\"1-2-2-1-7-2-2-2\" data-name=\"visitor institution cell\">Audit SKAI</div>\n<div class=\"w-[160px] text-[14px] text-[#53595F] truncate pr-4\" data-kid=\"1-2-2-1-7-2-2-3\" data-name=\"IT companion cell\">Ridwan Kamil</div>\n<div class=\"w-[160px] text-[14px] text-[#1B2A3A] truncate pr-4\" data-kid=\"1-2-2-1-7-2-2-4\" data-name=\"server room cell\">Server KC Bandung</div>\n<div class=\"w-[160px] text-[14px] text-[#1B2A3A] tabular-nums truncate pr-4\" data-kid=\"1-2-2-1-7-2-2-5\" data-name=\"entry time cell\">28 Okt, 09:30</div>\n<div class=\"w-[120px] text-[14px] text-[#1B2A3A] tabular-nums truncate pr-4\" data-kid=\"1-2-2-1-7-2-2-6\" data-name=\"initial temperature cell\">21.0 °C</div>\n<div class=\"w-[100px]\" data-kid=\"1-2-2-1-7-2-2-7\" data-name=\"duration cell wrapper\">\n<span class=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[6px] bg-[#F4F5F7] text-[#53595F] text-[13px] font-medium tabular-nums border border-[#D1D5D8]\" data-kid=\"1-2-2-1-7-2-2-7-1\" data-name=\"duration badge with neutral style\">\n<i class=\"bi bi-clock-history text-[11px]\" data-kid=\"1-2-2-1-7-2-2-7-1-1\" data-name=\"clock history icon\"></i> 45 min\n                </span>\n</div>\n<div class=\"flex-1 flex justify-end\" data-kid=\"1-2-2-1-7-2-2-8\" data-name=\"row actions cell\">\n<button class=\"h-[32px] px-3 rounded-[6px] border border-[#D1D5D8] bg-[#FFFFFF] text-[#1B2A3A] text-[13px] font-medium hover:bg-[#F4F5F7] shadow-sm\" data-kid=\"1-2-2-1-7-2-2-8-1\" data-name=\"view ticket button\">\n                  Lihat tiket\n                </button>\n</div>\n</div>\n<!-- Row 3 -->\n<div class=\"h-[52px] flex items-center px-4 hover:bg-[#F4F5F7] group\" data-kid=\"1-2-2-1-7-2-3\" data-name=\"third data row\">\n<div class=\"w-[200px] text-[14px] font-medium text-[#1B2A3A] truncate pr-4\" data-kid=\"1-2-2-1-7-2-3-1\" data-name=\"visitor name cell\">Kevin Wijaya</div>\n<div class=\"w-[180px] text-[14px] text-[#53595F] truncate pr-4\" data-kid=\"1-2-2-1-7-2-3-2\" data-name=\"visitor institution cell\">Vendor Cisco</div>\n<div class=\"w-[160px] text-[14px] text-[#53595F] truncate pr-4\" data-kid=\"1-2-2-1-7-2-3-3\" data-name=\"IT companion cell\">Andi Prasetyo</div>\n<div class=\"w-[160px] text-[14px] text-[#1B2A3A] truncate pr-4\" data-kid=\"1-2-2-1-7-2-3-4\" data-name=\"server room cell\">Server KPO</div>\n<div class=\"w-[160px] text-[14px] text-[#1B2A3A] tabular-nums truncate pr-4\" data-kid=\"1-2-2-1-7-2-3-5\" data-name=\"entry time cell\">28 Okt, 10:10</div>\n<div class=\"w-[120px] text-[14px] text-[#1B2A3A] tabular-nums truncate pr-4\" data-kid=\"1-2-2-1-7-2-3-6\" data-name=\"initial temperature cell\">20.8 °C</div>\n<div class=\"w-[100px]\" data-kid=\"1-2-2-1-7-2-3-7\" data-name=\"duration cell wrapper\">\n<span class=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[6px] bg-[#F4F5F7] text-[#53595F] text-[13px] font-medium tabular-nums border border-[#D1D5D8]\" data-kid=\"1-2-2-1-7-2-3-7-1\" data-name=\"duration badge with neutral style\">\n<i class=\"bi bi-clock-history text-[11px]\" data-kid=\"1-2-2-1-7-2-3-7-1-1\" data-name=\"clock history icon\"></i> 5 min\n                </span>\n</div>\n<div class=\"flex-1 flex justify-end\" data-kid=\"1-2-2-1-7-2-3-8\" data-name=\"row actions cell\">\n<button class=\"h-[32px] px-3 rounded-[6px] border border-[#D1D5D8] bg-[#FFFFFF] text-[#1B2A3A] text-[13px] font-medium hover:bg-[#F4F5F7] shadow-sm\" data-kid=\"1-2-2-1-7-2-3-8-1\" data-name=\"view ticket button\">\n                  Lihat tiket\n                </button>\n</div>\n</div>\n<!-- Empty Rows (to show structure) -->\n<div class=\"h-[52px] flex items-center px-4\" data-kid=\"1-2-2-1-7-2-4\" data-name=\"empty placeholder row\"></div>\n<div class=\"h-[52px] flex items-center px-4\" data-kid=\"1-2-2-1-7-2-5\" data-name=\"empty placeholder row\"></div>\n<div class=\"h-[52px] flex items-center px-4\" data-kid=\"1-2-2-1-7-2-6\" data-name=\"empty placeholder row\"></div>\n<div class=\"h-[52px] flex items-center px-4\" data-kid=\"1-2-2-1-7-2-7\" data-name=\"empty placeholder row\"></div>\n<div class=\"h-[52px] flex items-center px-4\" data-kid=\"1-2-2-1-7-2-8\" data-name=\"empty placeholder row\"></div>\n<div class=\"h-[52px] flex items-center px-4\" data-kid=\"1-2-2-1-7-2-9\" data-name=\"empty placeholder row\"></div>\n</div>\n<!-- Pagination (44px) -->\n<div class=\"h-[44px] px-4 flex items-center justify-between border-t border-[#D1D5D8] bg-[#FFFFFF]\" data-kid=\"1-2-2-1-7-3\" data-name=\"pagination bar\">\n<div class=\"text-[13px] text-[#53595F]\" data-kid=\"1-2-2-1-7-3-1\" data-name=\"results summary text\">\n              Menampilkan 1-3 dari 3 pengunjung\n            </div>\n<div class=\"flex items-center gap-1\" data-kid=\"1-2-2-1-7-3-2\" data-name=\"pagination controls\">\n<button class=\"w-8 h-8 rounded-[6px] flex items-center justify-center text-[#D1D5D8] cursor-not-allowed\" data-kid=\"1-2-2-1-7-3-2-1\" data-name=\"previous page button (disabled)\">\n<i class=\"bi bi-chevron-left text-[12px]\" data-kid=\"1-2-2-1-7-3-2-1-1\" data-name=\"left chevron icon\"></i>\n</button>\n<button class=\"w-8 h-8 rounded-[6px] flex items-center justify-center bg-[#F4F5F7] text-[#1B2A3A] text-[13px] font-medium\" data-kid=\"1-2-2-1-7-3-2-2\" data-name=\"current page number button\">\n                1\n              </button>\n<button class=\"w-8 h-8 rounded-[6px] flex items-center justify-center text-[#D1D5D8] cursor-not-allowed\" data-kid=\"1-2-2-1-7-3-2-3\" data-name=\"next page button (disabled)\">\n<i class=\"bi bi-chevron-right text-[12px]\" data-kid=\"1-2-2-1-7-3-2-3-1\" data-name=\"right chevron icon\"></i>\n</button>\n</div>\n</div>\n</div>\n</div>\n</main>\n</div>\n</div>",
