# ==============================================================================
# QR Maintenance - Apache API Directory Configuration (.htaccess)
# ==============================================================================

Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jika ada request ke /api/uploads/..., arahkan ke uploads/...
    RewriteRule ^api/uploads/(.*)$ uploads/$1 [L]
</IfModule>

# Izinkan akses langsung ke folder uploads (gambar foto unit aset)
<If "%{REQUEST_URI} =~ m#^/(api/)?uploads/#">
    Require all granted
</If>

# HTTP Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
