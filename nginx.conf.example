# ==============================================================================
# QR Maintenance - Nginx Server Configuration Example
# Simpan atau sertakan konfigurasi ini di /etc/nginx/sites-available/qr-maintenance
# ==============================================================================

server {
    listen 80;
    server_name maintenance.example.com; # Ganti dengan domain Anda
    return 301 https://$host$request_uri; # Redirect otomatis ke HTTPS
}

server {
    listen 443 ssl http2;
    server_name maintenance.example.com; # Ganti dengan domain Anda

    # Sertifikat SSL (Let's Encrypt / Cloudflare)
    # ssl_certificate /etc/letsencrypt/live/maintenance.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/maintenance.example.com/privkey.pem;

    root /var/www/Maintenance-QR-main; # Sesuaikan dengan path folder proyek Anda
    index api/dashboard.php api/index.php index.php;

    # 1. Matikan Directory Browsing
    autoindex off;

    # 2. HTTP Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self)" always;

    # 3. Blokir Akses ke File & Direktori Tersembunyi (.git, .env, dll.)
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # 4. Blokir Akses ke File Sensitif (Database, Backup, Template, Log, Docs)
    location ~* \.(env|json|sql|rar|zip|tar|gz|7z|xlsx|xls|csv|bak|log|md|example\.php)$ {
        # Pengecualian untuk manifest PWA agar aplikasi web tetap berfungsi
        location ~* manifest\.(json|webmanifest)$ {
            allow all;
        }
        deny all;
        return 404;
    }

    # 5. Blokir Akses Langsung ke Direktori Internal & Konfigurasi
    location ~* /(sql|api/includes|api/helpers)/ {
        deny all;
        return 404;
    }
    location = /config.local.php {
        deny all;
        return 404;
    }
    location = /config.local.example.php {
        deny all;
        return 404;
    }

    # 6. Routing File & Dynamic PHP Request
    location / {
        try_files $uri $uri/ /api/index.php?$args;
    }

    # 7. Eksekusi Script PHP melalui FastCGI
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock; # Sesuaikan versi PHP yang digunakan
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY ""; # Mencegah kerentanan httpoxy
    }

    # 8. Cache Static Assets (CSS, JS, Gambar, Web Fonts)
    location ~* \.(png|jpg|jpeg|gif|ico|svg|webp|css|js|woff|woff2|ttf|eot)$ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }
}
