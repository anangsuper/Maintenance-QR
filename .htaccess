# ==============================================================================
# QR Maintenance - Web Server Hardening & Hostinger Routing (.htaccess)
# ==============================================================================

DirectoryIndex index.php

# 1. Matikan Directory Browsing (Mencegah peretas melihat daftar isi folder)
Options -Indexes -MultiViews

# 2. Blokir Akses ke Direktori & File Tersembunyi (.git, .env, .github, dll.)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known)" - [F,L]
</IfModule>

# 3. Blokir Akses Langsung ke File Sensitif (Database, Backup, Dokumen, Konfigurasi)
<FilesMatch "\.(env|json|sql|rar|zip|tar|gz|7z|xlsx|xls|csv|bak|log|md|example\.php)$">
    # Izinkan file manifest PWA agar tetap dapat diakses browser
    <If "%{REQUEST_URI} =~ /manifest(\.webmanifest|\.json)$/">
        Require all granted
    </If>
    <Else>
        Require all denied
    </Else>
</FilesMatch>

# 4. Blokir Akses Khusus ke File Konfigurasi Lokal
<Files "config.local.php">
    Require all denied
</Files>
<Files "config.local.example.php">
    Require all denied
</Files>
<Files "config.hostinger.example.php">
    Require all denied
</Files>

# 5. Blokir Folder Internal & Routing Otomatis Hostinger
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses langsung ke folder internal PHP
    RewriteRule ^api/includes/ - [F,L]
    RewriteRule ^api/helpers/ - [F,L]
    RewriteRule ^api/views/ - [F,L]
    RewriteRule ^sql/ - [F,L]
    RewriteRule ^scratch/ - [F,L]

    # Map request /uploads/... ke api/uploads/...
    RewriteRule ^uploads/(.*)$ api/uploads/$1 [L]

    # Routing otomatis untuk semua halaman ke router api/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ api/index.php [QSA,L]
</IfModule>

# 6. HTTP Security Headers (Perlindungan Clickjacking, XSS, MIME-sniffing)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self)"
</IfModule>

# 7. Browser Caching & Kompresi Aset Statis untuk Akses Cepat
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>
